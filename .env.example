# ====== Discord ======
DISCORD_TOKEN=tu_token_del_bot
CLIENT_ID=id_de_la_aplicacion
# Si lo dejás vacío, los comandos se registran globalmente (tarda hasta 1h en aparecer)
GUILD_ID=id_del_servidor_de_pruebas
# El bot registra los comandos solo al arrancar. Poné false para que no lo haga en cada reinicio
DEPLOY_COMMANDS=true

# ====== MongoDB ======
MONGODB_URI=mongodb://127.0.0.1:27017/ocaso-rp
# Nombre de la base (se usa solo si MONGODB_URI no incluye una)
MONGODB_DB=ocaso-rp

# ====== Dueños / staff tecnico (IDs separados por coma) ======
OWNER_IDS=
# Roles de staff (IDs separados por coma) con acceso a comandos de staff
STAFF_ROLE_IDS=

# ====== Servidor SA-MP Ocaso Roleplay ======
SAMP_HOST=play.ocasoroleplay.com
SAMP_PORT=7777
SAMP_NAME=Ocaso Roleplay
SAMP_DISCORD=https://discord.gg/ocasoroleplay

# ====== Marca ======
BRAND_COLOR=#E8A33D

# Intent de presencia (opcional: contador de usuarios online). Requiere activarlo en el Developer Portal
USE_PRESENCE_INTENT=false
